+    slot_to_sym = [0] * (1 << prec)
+    for sym_i, f in enumerate(freqs):
+        c_start = cdf[-1]
+        for s_pos in range(c_start, c_start + f):
+            slot_to_sym[s_pos] = sym_i
+        cdf.append(c_start + f)
